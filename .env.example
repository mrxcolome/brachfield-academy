# ── App ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database (Neon Postgres) · Fase 2 ────────────────
DATABASE_URL=

# ── Payload CMS · Fase 7 ─────────────────────────────
PAYLOAD_SECRET=

# ── Better Auth · Fase 3 ─────────────────────────────
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ── Stripe · Fase 3 ──────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID_PROFESIONAL_MONTHLY=

# ── Cloudflare (Stream + R2) · Fase 7 ────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PUBLIC=
R2_BUCKET_PREMIUM=

# ── PostHog · Fase 15 ────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Analytics de producto (Fase 15): eventos server-side vía AnalyticsService.
# Sin la clave, la analítica queda desactivada (no-op). Host UE por defecto.
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# ── Resend · Fase 3 ──────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Brachfield Academy <hola@example.com>"

# ── Cloudflare R2 + Stream · Fase 11 ─────────────────
# Sin estas vars, media se guarda en disco local (solo dev).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=brachfield-academy-media
# Reservado para reproducción firmada / subida por API (aún sin uso)
CLOUDFLARE_STREAM_TOKEN=

# ── Cron de recordatorios de eventos · Fase 12 ──────
# Vercel lo envía como Authorization: Bearer al cron diario.
# Genera uno largo y aleatorio (ej.: openssl rand -hex 32).
CRON_SECRET=

# ── Sentry · Fase 18 ─────────────────────────────────
# Sin DSN, Sentry es un no-op. Poner el MISMO valor en ambas.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
